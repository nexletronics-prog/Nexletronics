
# ==========================================================
# FIREBASE AUTHENTICATION — PUBLIC FRONTEND CONFIGURATION
# ==========================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id


# ==========================================================
# SUPABASE — PUBLIC FRONTEND CONFIGURATION
# ==========================================================

VITE_SUPABASE_URL=https://your_project_ref.supabase.co

# Use your project's publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional legacy fallback if your project still uses an anon key.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key


# ==========================================================
# EMAILJS — PUBLIC FRONTEND CONFIGURATION
# ==========================================================

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key


# ==========================================================
# SERVER ONLY — FIREBASE ADMIN SDK
# Configure in local server environment and Vercel.
# ==========================================================

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="your_private_key_with_escaped_newlines"


# ==========================================================
# SERVER ONLY — SUPABASE ADMIN ACCESS
# NEVER prefix this key with VITE_.
# ==========================================================

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional backward-compatible URL used by older server code.
# Keep this equal to VITE_SUPABASE_URL if you configure it.
# SUPABASE_URL=https://your_project_ref.supabase.co


# ==========================================================
# SERVER ONLY — ADMIN AUTHORIZATION CONFIGURATION
# Use actual Firebase UIDs, separated by commas.
# ==========================================================

NEXLETRONICS_ADMIN_UIDS=your_firebase_admin_uid


# ==========================================================
# SERVER ONLY — RAZORPAY
# Do not expose secret keys in frontend configuration.
# ==========================================================

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# ==========================================================
# SERVER ONLY — GOOGLE SHEETS INTEGRATION
# ==========================================================

GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/your_deployment_id/exec
